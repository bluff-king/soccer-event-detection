# Copy to .env (git-ignored) and fill in. Loaded when the `sed` package is imported; real env variables win.
WANDB_API_KEY=            # https://wandb.ai/authorize (logging.wandb: true)
WANDB_ENTITY=             # optional W&B team/user
HF_HOME=                  # optional Hugging Face cache location, e.g. D:/hf_cache
